{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "description": "Weft: live state — cell graph, inputs, requirements",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#link/*": "./src/link/*",
    "#weft": "./src/index.ts",
    "#weft/react": "./src/react/hooks.ts"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\" \"demo/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:bench": "node demo/bench.ts",
    "demo:preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=26.0"
  }
}
