{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "description": "Weft: live state — cell graph, inputs, requirements",
  "type": "module",
  "imports": {
    "#graph": "./packages/graph/src/index.ts",
    "#graph/*": "./packages/graph/src/*",
    "#remote": "./packages/remote/src/index.ts",
    "#remote/*": "./packages/remote/src/*",
    "#rel": "./packages/rel/src/index.ts",
    "#rel/*": "./packages/rel/src/*",
    "#keep": "./packages/keep/src/index.ts",
    "#keep/*": "./packages/keep/src/*",
    "#link": "./packages/link/src/index.ts",
    "#link/*": "./packages/link/src/*",
    "#weft": "./packages/weft/src/index.ts",
    "#weft/*": "./packages/weft/src/*",
    "#react": "./packages/react/src/index.ts",
    "#loom": "./packages/loom/src/index.ts",
    "#loom/react": "./packages/loom/src/react.ts",
    "#testkit": "./packages/testkit/src/index.ts",
    "#data": "./packages/data/src/index.ts",
    "#data/*": "./packages/data/src/*",
    "#table": "./packages/table/src/index.ts",
    "#table/*": "./packages/table/src/*",
    "#demo": "./demo/common/index.ts",
    "#demo/*": "./demo/common/*",
    "#kanban": "./demo/kanban-common/index.ts",
    "#kanban/*": "./demo/kanban-common/*"
  },
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"test/**/*.test.ts\" \"demo/**/*.test.ts\"",
    "test:weft": "node --test \"packages/**/*.test.ts\" \"test/weft/**/*.test.ts\"",
    "test:weft-react": "node --test \"test/weft-react/*.test.ts\"",
    "test:loom": "node --test \"test/loom/*.test.ts\"",
    "test:stands": "node --test \"demo/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:bench": "node demo/bench/sheets.ts",
    "demo:list": "node demo/bench/lists.ts",
    "demo:folds": "node demo/bench/folds.ts",
    "demo:wire": "node demo/bench/wire.ts",
    "demo:preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@happy-dom/global-registrator": "^16.8.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^16.8.1",
    "lucide-react": "^1.28.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-observable": "^3.0.0-rc.3",
    "reselect": "^5.2.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=26.0"
  }
}
